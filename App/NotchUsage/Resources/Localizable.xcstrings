{
  "sourceLanguage": "en",
  "strings": {
    "%@, %lld percent, resets %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$lld percent, resets %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld pour cent, réinitialisation %3$@"
          }
        }
      }
    },
    "%@: %@ used.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : %2$@ utilisés."
          }
        }
      }
    },
    "%@: at this pace, blocked at %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : à ce rythme, blocage à %2$@."
          }
        }
      }
    },
    "%@: back in %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : retour dans %2$@."
