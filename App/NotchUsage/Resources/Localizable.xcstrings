            "state": "translated",
            "value": "Connexion"
          }
        }
      }
    },
    "Connect your Claude account": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre compte Claude"
          }
        }
