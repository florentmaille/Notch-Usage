    "Checking your usage…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre consommation…"
          }
        }
      }
    },
    "Claude Code could not renew its session. Run claude in Terminal, or sign in with your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n'a pas pu renouveler sa session. Lancez claude dans le Terminal, ou connectez-vous avec votre navigateur."
          }
        }
      }
    },
    "Claude Code did not answer in time. Try again, or run claude in Terminal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n'a pas répondu à temps. Réessayez, ou lancez claude dans le Terminal."
          }
        }
      }
    },
    "Claude Code is signed out. Run claude in Terminal and sign in, or use your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code est déconnecté. Lancez claude dans le Terminal et connectez-vous, ou utilisez votre navigateur."
          }
        }
      }
    },
    "Claude Code was not found on this Mac. Run claude in Terminal, or sign in with your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code est introuvable sur ce Mac. Lancez claude dans le Terminal, ou connectez-vous avec votre navigateur."
          }
        }
      }
    },
    "Claude did not answer in time. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude n'a pas répondu à temps. Réessayez."
          }
        }
      }
    },
    "Claude is rate-limiting usage requests. Try again in a few minutes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude limite les demandes de consommation. Réessayez dans quelques minutes."
          }
        }
      }
    },
    "Claude rate-limits this endpoint. 3 minutes is a safe default.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude limite la fréquence de ces demandes. 3 minutes est une valeur sûre."
          }
        }
      }
    },
    "Claude rejected the credentials. Try signing in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude a refusé les identifiants. Reconnectez-vous."
          }
        }
      }
    },
