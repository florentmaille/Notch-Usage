    "Notch Usage, reconnect required": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch Usage, reconnexion nécessaire"
          }
        }
      }
    },
    "One alert per threshold, per limit and per reset period. Changes apply on the next refresh.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alerte par seuil, par limite et par période. Les changements s’appliquent au prochain relevé."
          }
        }
      }
    },
    "Open at login": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer à l’ouverture de session"
          }
        }
      }
    },
    "Open sign-in": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir la connexion"
          }
        }
      }
    },
    "Opens claude.ai in a small window. The session cookie stays in your Keychain.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre claude.ai dans une petite fenêtre. Le cookie de session reste dans votre trousseau."
          }
        }
      }
    },
    "Plan not supported": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre non prise en charge"
          }
        }
      }
    },
    "Reads the token Claude Code already stored in your Keychain. macOS will ask you to allow it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit le jeton que Claude Code a déjà enregistré dans votre trousseau. macOS vous demandera l’autorisation."
          }
        }
      }
    },
