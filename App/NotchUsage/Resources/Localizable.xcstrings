    "That does not look like a Claude session key (it should start with sk-ant-sid).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une clé de session Claude (elle doit commencer par sk-ant-sid)."
          }
        }
      }
    },
    "The Claude Code credentials could not be read. Open Claude Code once, then retry.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les identifiants de Claude Code. Ouvrez Claude Code une fois, puis réessayez."
          }
        }
      }
    },
    "The Claude Code session is still expired. Run claude in Terminal, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session Claude Code est toujours expirée. Lancez claude dans le Terminal, puis réessayez."
          }
        }
      }
    },
    "This Claude plan does not expose usage limits. Pro, Max or Team is required.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre Claude ne fournit pas de limites de consommation. Pro, Max ou Team est nécessaire."
          }
        }
      }
    },
    "Thresholds colour the edge and the panel for weekly limits and before a forecast exists. The notch always shows the limit most likely to block you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les seuils colorent le liseré et le panneau pour les limites hebdomadaires et avant qu'une prévision existe. L'encoche montre toujours la limite la plus susceptible de bloquer."
          }
        }
      }
    },
    "Usage warning": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement de consommation"
          }
        }
      }
    },
    "Use": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser"
          }
        }
      }
    },
    "Use Claude Code session": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la session Claude Code"
          }
        }
      }
    },
    "Use thresholds when no forecast exists": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les seuils quand aucune prévision n'existe"
          }
        }
      }
    },
    "Uses undocumented Claude endpoints. Nothing leaves your Mac, but Anthropic may change or block them. Use at your own risk.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise des points d’accès Claude non documentés. Rien ne quitte votre Mac, mais Anthropic peut les modifier ou les bloquer. À utiliser à vos risques."
          }
        }
      }
    },
    "Waiting for approval in System Settings → General → Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation dans Réglages Système → Général → Ouverture."
          }
        }
      }
    },
    "Waiting for the first reading…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du premier relevé…"
          }
        }
      }
    },
