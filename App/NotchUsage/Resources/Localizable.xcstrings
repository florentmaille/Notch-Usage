{
  "sourceLanguage": "en",
  "strings": {
    "%@, %lld percent, resets %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$lld percent, resets %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld pour cent, réinitialisation %3$@"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      }
    },
