    "Data unavailable, showing the last reading.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données indisponibles, affichage du dernier relevé."
          }
        }
      }
    },
    "FULL": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PLEIN"
          }
        }
      }
    },
    "Fallback if the browser sign-in is blocked: paste the sessionKey cookie from claude.ai.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Solution de secours si la connexion par navigateur est bloquée : collez le cookie sessionKey de claude.ai."
          }
        }
      }
    },
    "Highlight the notch when a limit gets close": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler dans l’encoche une limite proche"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue"
          }
        }
      }
    },
    "Last reading is older than 30 minutes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier relevé il y a plus de 30 minutes."
          }
        }
      }
    },
    "No Claude Code session found. Sign in to Claude Code first, or use the browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune session Claude Code trouvée. Connectez-vous d’abord à Claude Code, ou utilisez le navigateur."
          }
        }
      }
    },
    "No network connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion réseau."
          }
        }
      }
    },
    "Notch Usage shows your Pro or Max limits. Pick how to connect:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch Usage affiche vos limites Pro ou Max. Choisissez comment vous connecter :"
          }
        }
      }
    },
    "Notch Usage, data unavailable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch Usage, données indisponibles"
