    },
    "Weekly · %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebdomadaire · %@"
          }
        }
      }
    },
    "Weekly, all models": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebdomadaire, tous modèles"
          }
        }
      }
    },
    "Your Claude Code session has expired. Renew it here: Notch Usage asks Claude Code for a one-word reply, which counts as a tiny request. Or run claude in Terminal, or sign in with your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Claude Code a expiré. Renouvelez-la ici : Notch Usage demande à Claude Code une réponse d'un mot, qui compte comme une toute petite requête. Ou lancez claude dans le Terminal, ou connectez-vous avec votre navigateur."
          }
        }
      }
    },
    "Your Claude Code session has expired. Run claude in Terminal once to renew it: Notch Usage reconnects automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Claude Code a expiré. Lancez claude une fois dans le Terminal pour la renouveler : Notch Usage se reconnecte seul."
          }
        }
      }
    },
    "Your claude.ai session has expired. Sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session claude.ai a expiré. Reconnectez-vous."
          }
        }
      }
    },
    "claude.ai asked for a browser check.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai demande une vérification du navigateur."
          }
        }
      }
    },
    "claude.ai asked for a browser check. Open the sign-in window and complete it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai demande une vérification du navigateur. Ouvrez la fenêtre de connexion et terminez-la."
          }
        }
      }
    },
    "sk-ant-sid…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
