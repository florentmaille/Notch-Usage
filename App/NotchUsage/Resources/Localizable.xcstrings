    "That does not look like a Claude session key (it should start with sk-ant-sid).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une clé de session Claude (elle doit commencer par sk-ant-sid)."
          }
        }
      }
    },
    "The Claude Code credentials could not be read. Open Claude Code once, then retry.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les identifiants de Claude Code. Ouvrez Claude Code une fois, puis réessayez."
          }
        }
      }
    },
    "The Claude Code session is still expired. Run claude in Terminal, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session Claude Code est toujours expirée. Lancez claude dans le Terminal, puis réessayez."
          }
        }
      }
    },
    "This Claude plan does not expose usage limits. Pro, Max or Team is required.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre Claude ne fournit pas de limites de consommation. Pro, Max ou Team est nécessaire."
          }
        }
      }
    },
    "Usage warning": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avertissement de consommation"
          }
        }
      }
    },
    "Use": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser"
          }
        }
      }
    },
    "Use Claude Code session": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la session Claude Code"
          }
        }
      }
    },
    "Uses undocumented Claude endpoints. Nothing leaves your Mac, but Anthropic may change or block them. Use at your own risk.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise des points d’accès Claude non documentés. Rien ne quitte votre Mac, mais Anthropic peut les modifier ou les bloquer. À utiliser à vos risques."
          }
        }
      }
    },
    "Waiting for approval in System Settings → General → Login Items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation dans Réglages Système → Général → Ouverture."
          }
        }
      }
    },
    "Waiting for the first reading…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du premier relevé…"
          }
        }
      }
    },
    "Warning at %lld%%": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention à %lld %%"
          }
        }
      }
    },
    "Weekly · %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebdomadaire · %@"
          }
        }
      }
    },
    "Weekly, all models": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebdomadaire, tous modèles"
          }
        }
      }
    },
    "Your Claude Code session has expired. Run claude in Terminal once to renew it: Notch Usage reconnects automatically within 30 seconds. Or sign in with your browser.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Claude Code a expiré. Lancez claude une fois dans le Terminal pour la renouveler : Notch Usage se reconnecte seul en moins de 30 secondes. Ou connectez-vous avec le navigateur."
          }
        }
      }
    },
    "Your Claude Code session has expired. Run claude in Terminal once to renew it: Notch Usage reconnects automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session Claude Code a expiré. Lancez claude une fois dans le Terminal pour la renouveler : Notch Usage se reconnecte seul."
          }
        }
      }
    },
    "Your claude.ai session has expired. Sign in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session claude.ai a expiré. Reconnectez-vous."
          }
        }
      }
    },
    "claude.ai asked for a browser check.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai demande une vérification du navigateur."
          }
        }
      }
    },
    "claude.ai asked for a browser check. Open the sign-in window and complete it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude.ai demande une vérification du navigateur. Ouvrez la fenêtre de connexion et terminez-la."
          }
        }
      }
    },
