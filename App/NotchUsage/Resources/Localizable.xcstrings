    },
    "Connected via Claude Code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté via Claude Code"
          }
        }
      }
    },
    "Connected via browser": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté via le navigateur"
          }
        }
      }
    },
    "Could not read usage data. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la consommation. Réessayez."
          }
        }
      }
    },
    "Critical at %lld%%": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
