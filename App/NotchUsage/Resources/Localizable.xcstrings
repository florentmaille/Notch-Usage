    "1 min": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 min"
          }
        }
      }
    },
    "5-hour window": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre de 5 h"
          }
        }
      }
    },
    "Alerts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertes"
          }
        }
      }
    },
    "Applies after a restart.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique après un redémarrage."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour"
          }
        }
      }
    },
    "Blocked, resets %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué, réinitialisation %@"
          }
        }
      }
    },
    "Checking your usage…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre consommation…"
          }
        }
      }
    },
    "Claude is rate-limiting usage requests. Try again in a few minutes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude limite les demandes de consommation. Réessayez dans quelques minutes."
          }
        }
      }
    },
    "Claude rate-limits this endpoint. 3 minutes is a safe default.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude limite la fréquence de ces demandes. 3 minutes est une valeur sûre."
          }
        }
      }
    },
    "Claude rejected the credentials. Try signing in again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude a refusé les identifiants. Reconnectez-vous."
          }
        }
      }
    },
    "Claude usage": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consommation Claude"
          }
        }
